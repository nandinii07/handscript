# Handwrite - example environment configuration.
#
# Copy to .env for local use (`cp .env.example .env`) and adjust as needed.
# There are no secrets to set here - no API key, no credential - because
# nothing in this application talks to a third party. What varies between a
# laptop and a deployed instance is entirely paths and limits.
#
# Do not commit a real .env file; it is listed in .gitignore.

# Where job directories (uploaded pages, intermediate files, finished fonts)
# and the SQLite job database live. Mount a volume here in production so jobs
# survive the container being recreated, not only restarted.
HANDWRITE_JOB_ROOT=/tmp/handwrite-jobs

# How long a finished (completed or failed) job is kept before its files and
# metadata are deleted. A job that is still queued or processing is never
# touched, however old it is.
HANDWRITE_JOB_TTL_HOURS=24

# Largest single page image accepted, in megabytes.
HANDWRITE_MAX_UPLOAD_MB=10

# Longest a single font build may run before it is given up on and the job
# marked failed (seconds). Guards against a wedged potrace/FontForge process.
HANDWRITE_BUILD_TIMEOUT=120

# How many font builds may run at once. Each one starts a FontForge
# subprocess and spends most of its time in potrace, so this is a CPU/process
# limit more than a memory one - 2 to 4 suits a single small container.
HANDWRITE_MAX_WORKERS=3

# Default font family name used when a request does not supply one.
HANDWRITE_FONT_FAMILY=MyHandwriting

# Standard Python logging level: DEBUG, INFO, WARNING, ERROR.
HANDWRITE_LOG_LEVEL=INFO
